    \preformatted{NutritionDataAnalytics$quality_diagnose()}
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    A tibble (invisibly) with one row per quality check, covering
  both anthropometric and IYCF schemas.
  }
}

